#!/bin/sh
# Minimal i.MX6ULL Mini boot script (BusyBox initramfs).
PATH=/sbin:/usr/sbin:/bin:/usr/bin

mount -a
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
mdev -s

hostname imx6ull-mini

# Keep kernel messages on ttymxc0; stop fbcon from drawing over LVGL.
if [ -e /sys/class/vtconsole/vtcon1/bind ]; then
    echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
fi
if [ -e /sys/class/graphics/fbcon/cursor_blink ]; then
    echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null || true
fi

# LVGL renders on the CPU; ondemand parks it at 198 MHz between touch events,
# which is exactly when the UI redraws, so pin the highest OPP first.
GOV=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
if [ -e "$GOV" ]; then
    MAX=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null)
    [ -n "$MAX" ] && echo "$MAX" > /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null
    echo performance > "$GOV" 2>/dev/null || true
fi

# Static binary, no shared libraries required.
if [ -x /usr/bin/lvgl_demo ]; then
    /usr/bin/lvgl_demo >/var/log/lvgl.log 2>&1 &
fi

echo "imx6ull-mini: rootfs ready"
